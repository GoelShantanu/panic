www.bazaarpanic.com, bazaarpanic.in, www.bazaarpanic.in {
    redir https://bazaarpanic.com{uri} permanent
}

bazaarpanic.com {
    # Remove revealing server & framework signature headers
    header {
        -Server
        -X-Powered-By
        -X-Nextjs-Cache
        -X-Nextjs-Matched-Path
        -X-Nextjs-Redirect
    }

    # Block automated AI scrapers and clone bots before any route handling
    @ai_scrapers header_regexp User-Agent (?i)(GPTBot|ChatGPT-User|ClaudeBot|Claude-Web|Bytespider|CCBot|Amazonbot|Diffbot|FacebookBot|PetalBot|SemrushBot|AhrefsBot)
    handle @ai_scrapers {
        respond "Forbidden" 403
    }

    handle /v1/live* {
        reverse_proxy 127.0.0.1:3003 {
            flush_interval -1
        }
    }
    handle {
        reverse_proxy 127.0.0.1:3002
    }
}
