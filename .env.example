# Copy to .env.local for local development only. It is ignored by Git.
# Set AUTH_SECRET to a random, stable value of at least 32 characters.
DATABASE_URL=postgresql://postgres:stockpanic_dev_only@127.0.0.1:5432/stockpanic
PORT=3002
LIVE_ORIGIN=http://127.0.0.1:3003
NEXT_DIST_DIR=.next-local
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
AUTH_SECRET=

# Google OAuth Web application client ID (public). No client secret is needed.
GOOGLE_CLIENT_ID=

# log prints codes locally. For actual delivery use smtp and configure the sender.
MAILER=log
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Razorpay Test Mode for local payment testing. Keep secrets in ignored .env.local.
# Register /v1/billing/webhook at an HTTPS URL with the same signing secret.
# Use monthly INR 299 and yearly INR 2,999 plans; never mix test and live IDs.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
RAZORPAY_WEBHOOK_SECRET=

# Required invoice seller details. Use explicit TEST ONLY placeholders locally;
# replace with actual business details before live billing. Blank GSTIN = unregistered.
SELLER_NAME=
SELLER_ADDRESS=
SELLER_GSTIN=
SELLER_SAC=
