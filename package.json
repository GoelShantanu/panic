{
  "name": "stockpanic",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "src/packages/*",
    "src/apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p src/apps/web/tsconfig.json",
    "web:build": "next build src/apps/web",
    "test": "vitest run",
    "db:migrate": "node src/packages/db/src/cli/migrate.ts"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
